# Copy to android/key.properties (gitignored) and fill in YOUR keystore details.
# Create the keystore yourself, e.g.:
#   keytool -genkey -v -keystore ~/reptrack-upload.jks -keyalg RSA -keysize 2048 -validity 10000 -alias upload
# Never commit the keystore or this file with real values.
storeFile=../../reptrack-upload.jks
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
