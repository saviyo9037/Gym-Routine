# Copy the JSON below into a gitignored file named env.local.json and pass it to Flutter with
#   flutter run --dart-define-from-file=env.local.json
# Do NOT put real values in this example file. Never commit real values.
# The app runs fully locally when these are empty (see ACCESS_MODEL below for what that means).
#
# env.local.json:
# {
#   "SUPABASE_URL": "https://<your-project-ref>.supabase.co",
#   "SUPABASE_ANON_KEY": "<Supabase anon / publishable key>",
#   "REVENUECAT_ANDROID_API_KEY": "<RevenueCat public Android SDK key>",
#   "GOOGLE_WEB_CLIENT_ID": "<Google OAuth *web* client id used by Supabase>",
#   "PRIVACY_POLICY_URL": "https://<your-hosted-privacy-policy>",
#   "TERMS_URL": "https://<your-hosted-terms>",
#   "ACCESS_MODEL": "subscription_required"
# }
#
# ACCESS_MODEL: subscription_required (default) = the app is locked until the user has an
#   active subscription or the store-managed trial; freemium = old model (free core + premium extras).
# PRIVACY_POLICY_URL / TERMS_URL: https only. When empty the app hides those links, and a
#   release without them is NOT ready for Play (see RELEASE_CHECKLIST.md).
# A release build without REVENUECAT_ANDROID_API_KEY stays locked (debug builds stay open for development).
SUPABASE_URL=
SUPABASE_ANON_KEY=
REVENUECAT_ANDROID_API_KEY=
GOOGLE_WEB_CLIENT_ID=
PRIVACY_POLICY_URL=
TERMS_URL=
ACCESS_MODEL=subscription_required
