# Copy this file to .env.local and REPLACE every value below with your own.
# Leaving the example text in place makes the app show "not configured".
# Never commit real values.
#
# Project URL: Supabase dashboard > Project Settings > API > Project URL
#   looks like  https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://REPLACE-WITH-YOUR-PROJECT-REF.supabase.co
# anon / publishable key: same page (long string starting with eyJ... or sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE-WITH-YOUR-ANON-KEY
# SERVER ONLY - never prefix with NEXT_PUBLIC_, never import from client components.
SUPABASE_SERVICE_ROLE_KEY=REPLACE-WITH-YOUR-SERVICE-ROLE-KEY

# OPTIONAL, SERVER ONLY (read-only store plan table on "Plans & Paywall"). Never prefix with NEXT_PUBLIC_.
# A RevenueCat API v2 *secret* key with read access, and your RevenueCat project id. Leave as is to hide the table.
REVENUECAT_API_KEY=REPLACE-WITH-YOUR-REVENUECAT-V2-SECRET-KEY
REVENUECAT_PROJECT_ID=REPLACE-WITH-YOUR-REVENUECAT-PROJECT-ID
